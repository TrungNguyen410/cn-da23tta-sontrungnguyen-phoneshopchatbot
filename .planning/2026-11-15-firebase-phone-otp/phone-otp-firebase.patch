+/* ---------- Registration OTP: resend countdown ---------- */
+.otp-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-xs) var(--space-md);
+  margin: 0 0 var(--space-md);
+}
+
+.otp-actions .auth-text-button {
+  margin: 0;
+}
+
+.otp-actions .auth-text-button:disabled {
+  opacity: 0.6;
+  cursor: wait;
+}
+
+.otp-resend-wait {
+  color: var(--color-ink-muted);
+  font-size: var(--text-xs);
+  font-variant-numeric: tabular-nums;
+}
+
+.otp-resend-wait b {
+  color: var(--color-ink);
+}
+
+/* ---------- Registration with Firebase Phone Auth ---------- */
+.recaptcha-host:empty {
+  display: none;
+}
+
+/* Google allows hiding the floating badge when the notice below is visible in the flow. */
+.grecaptcha-badge {
+  visibility: hidden;
+}
+
+.recaptcha-note {
+  margin: var(--space-sm) 0 0;
+  color: var(--color-ink-muted);
+  font-size: var(--text-xs);
+  text-align: center;
+  text-wrap: pretty;
+}
+
+.recaptcha-note a {
+  color: var(--color-accent);
+}
