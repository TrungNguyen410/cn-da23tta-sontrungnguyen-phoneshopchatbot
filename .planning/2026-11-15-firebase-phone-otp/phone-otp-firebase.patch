@@ -0,0 +1,116 @@
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { MemoryRouter, Route, Routes } from 'react-router-dom';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import Register from './Register';
+
+const auth = vi.hoisted(() => ({
+  logout: vi.fn(),
+  requestRegistrationOtp: vi.fn(),
+  verifyRegistrationOtp: vi.fn(),
+  registerWithFirebase: vi.fn(),
+}));
+const firebasePhone = vi.hoisted(() => ({
+  sendPhoneCode: vi.fn(),
+  confirmPhoneCode: vi.fn(),
+  releasePhoneVerifier: vi.fn(),
+}));
+const api = vi.hoisted(() => ({ checkRegistrationPhone: vi.fn() }));
+const toast = vi.hoisted(() => ({ error: vi.fn(), success: vi.fn() }));
+
+vi.mock('../hooks/useAuth', () => ({ useAuth: () => auth }));
+vi.mock('../api/firebasePhoneApi', () => firebasePhone);
+vi.mock('../api/authApi', () => ({ authApi: api }));
+vi.mock('react-toastify', () => ({ toast }));
+vi.mock('../utils/runtimeConfig', async (importOriginal) => {
+  const actual = await importOriginal();
+  return { ...actual, runtimeConfig: { ...actual.runtimeConfig, phoneOtpProvider: 'firebase' } };
+});
+
+const renderRegister = () => render(
+  <MemoryRouter initialEntries={['/register']}>
+    <Routes>
+      <Route path="/register" element={<Register />} />
+      <Route path="/login" element={<p>Trang đăng nhập</p>} />
+    </Routes>
+  </MemoryRouter>,
+);
+
+const fillDetails = () => {
+  fireEvent.change(screen.getByLabelText('Họ và tên'), { target: { value: 'Võ Minh Thư' } });
+  fireEvent.change(screen.getByLabelText('Số điện thoại'), { target: { value: '0900000111' } });
+  fireEvent.change(screen.getByLabelText('Mật khẩu'), { target: { value: 'mk-thu-2026' } });
+  fireEvent.change(screen.getByLabelText('Xác nhận mật khẩu'), { target: { value: 'mk-thu-2026' } });
+  fireEvent.click(screen.getByRole('button', { name: 'Gửi mã xác minh' }));
+};
+
+const enterCode = (code) => {
+  fireEvent.change(screen.getByLabelText('Mã OTP'), { target: { value: code } });
+  fireEvent.click(screen.getByRole('button', { name: 'Xác minh và đăng ký' }));
+};
+
+describe('Register with Firebase Phone Auth', () => {
+  afterEach(() => {
+    cleanup();
+    vi.clearAllMocks();
+  });
+
+  it('checks the number, lets Firebase send and check the code, then creates the account', async () => {
+    const confirmation = { confirm: vi.fn() };
+    api.checkRegistrationPhone.mockResolvedValue({ available: true });
+    firebasePhone.sendPhoneCode.mockResolvedValue(confirmation);
+    firebasePhone.confirmPhoneCode.mockResolvedValue('firebase-id-token');
+    auth.registerWithFirebase.mockResolvedValue({ user: { id: 'u1' } });
+    renderRegister();
+
+    expect(screen.getByText(/bảo vệ bởi reCAPTCHA/)).toBeInTheDocument();
+    fillDetails();
+
+    expect(await screen.findByRole('heading', { name: 'Nhập mã OTP' })).toBeInTheDocument();
+    expect(screen.getByText(/đã được gửi qua SMS đến 090\*\*\*111/)).toBeInTheDocument();
+    expect(api.checkRegistrationPhone).toHaveBeenCalledWith('0900000111');
+    expect(firebasePhone.sendPhoneCode).toHaveBeenCalledWith('0900000111', expect.any(HTMLDivElement));
+    expect(auth.requestRegistrationOtp).not.toHaveBeenCalled();
+
+    enterCode('246810');
+
+    expect(await screen.findByText('Trang đăng nhập')).toBeInTheDocument();
+    expect(firebasePhone.confirmPhoneCode).toHaveBeenCalledWith(confirmation, '246810');
+    expect(auth.registerWithFirebase).toHaveBeenCalledWith({
+      fullName: 'Võ Minh Thư',
+      phone: '0900000111',
+      password: 'mk-thu-2026',
+      idToken: 'firebase-id-token',
+    });
+    expect(auth.logout).toHaveBeenCalled();
+  });
+
+  it('does not spend an SMS on a number that is already registered', async () => {
+    api.checkRegistrationPhone.mockRejectedValue(Object.assign(new Error('409'), { friendlyMessage: 'Số điện thoại này đã được đăng ký' }));
+    renderRegister();
+    fillDetails();
+
+    await waitFor(() => expect(toast.error).toHaveBeenCalledWith('Số điện thoại này đã được đăng ký'));
+    expect(firebasePhone.sendPhoneCode).not.toHaveBeenCalled();
+    expect(screen.getByRole('heading', { name: 'Đăng ký thành viên' })).toBeInTheDocument();
+  });
+
+  it('retries the account request with the same verified token instead of a new SMS', async () => {
+    api.checkRegistrationPhone.mockResolvedValue({ available: true });
+    firebasePhone.sendPhoneCode.mockResolvedValue({ confirm: vi.fn() });
+    firebasePhone.confirmPhoneCode.mockResolvedValue('firebase-id-token');
+    auth.registerWithFirebase
+      .mockRejectedValueOnce(Object.assign(new Error('offline'), { friendlyMessage: 'Không thể kết nối máy chủ' }))
+      .mockResolvedValueOnce({ user: { id: 'u1' } });
+    renderRegister();
+    fillDetails();
+    await screen.findByRole('heading', { name: 'Nhập mã OTP' });
+
+    enterCode('246810');
+    await waitFor(() => expect(toast.error).toHaveBeenCalledWith('Không thể kết nối máy chủ'));
+    fireEvent.click(screen.getByRole('button', { name: 'Xác minh và đăng ký' }));
+
+    expect(await screen.findByText('Trang đăng nhập')).toBeInTheDocument();
+    expect(firebasePhone.confirmPhoneCode).toHaveBeenCalledTimes(1);
+    expect(auth.registerWithFirebase).toHaveBeenCalledTimes(2);
+  });
+});
