+import { runtimeConfig } from '../utils/runtimeConfig';
+import { normalizeVietnamesePhone } from '../utils/validators';
+
+// Firebase only proves the phone number. The account itself is created by our backend from the ID token,
+// so the Firebase session lives in memory and is signed out right after the token is read.
+
+const FIREBASE_ERRORS = {
+  'auth/invalid-phone-number': 'Số điện thoại không hợp lệ.',
+  'auth/missing-phone-number': 'Vui lòng nhập số điện thoại.',
+  'auth/invalid-verification-code': 'Mã OTP không đúng. Vui lòng kiểm tra lại.',
+  'auth/missing-verification-code': 'Vui lòng nhập mã OTP gồm 6 chữ số.',
+  'auth/code-expired': 'Mã OTP đã hết hạn. Vui lòng bấm "Gửi lại mã".',
+  'auth/session-expired': 'Mã OTP đã hết hạn. Vui lòng bấm "Gửi lại mã".',
+  'auth/too-many-requests': 'Bạn đã yêu cầu quá nhiều lần. Vui lòng thử lại sau ít phút.',
+  'auth/quota-exceeded': 'Đã hết hạn mức gửi SMS. Vui lòng thử lại sau.',
+  'auth/captcha-check-failed': 'Kiểm tra chống spam (reCAPTCHA) thất bại. Vui lòng tải lại trang rồi thử lại.',
+  'auth/invalid-app-credential': 'Kiểm tra chống spam (reCAPTCHA) không hợp lệ. Vui lòng tải lại trang rồi thử lại.',
+  'auth/network-request-failed': 'Không kết nối được dịch vụ xác minh. Vui lòng kiểm tra mạng.',
+  'auth/operation-not-allowed': 'Firebase chưa cho phép gửi SMS: hãy bật Phone trong Sign-in method và cho phép Việt Nam trong SMS region policy.',
+  'auth/unauthorized-domain': 'Tên miền này chưa được thêm vào Authorized domains của Firebase.',
+  'auth/billing-not-enabled': 'Dự án Firebase chưa bật gói Blaze nên chưa gửi được SMS thật. Hãy dùng số điện thoại thử nghiệm.',
+};
+
+export const firebaseErrorMessage = (error) => {
+  if (FIREBASE_ERRORS[error?.code]) return FIREBASE_ERRORS[error.code];
+  if (error?.code) return `Không xác minh được số điện thoại (${error.code}).`;
+  return 'Không xác minh được số điện thoại. Vui lòng thử lại.';
+};
+
+const friendlyError = (error) => {
+  const wrapped = new Error(firebaseErrorMessage(error));
+  wrapped.friendlyMessage = wrapped.message;
+  wrapped.code = error?.code;
+  return wrapped;
+};
+
+export const toE164 = (phone) => {
+  const normalized = normalizeVietnamesePhone(phone);
+  return normalized ? `+84${normalized.slice(1)}` : '';
+};
+
+let firebasePromise = null;
+let verifier = null;
+let verifierHost = null;
+
+// The SDK is fetched on first use, so only the sign-up page downloads it.
+const loadFirebase = () => {
+  firebasePromise ||= Promise.all([import('firebase/app'), import('firebase/auth')])
+    .then(([appModule, authModule]) => {
+      const app = appModule.initializeApp(runtimeConfig.firebase);
+      const auth = authModule.initializeAuth(app, { persistence: authModule.inMemoryPersistence });
+      auth.languageCode = 'vi';
+      return { auth, authModule };
+    })
+    .catch((error) => {
+      firebasePromise = null;
+      throw error;
+    });
+  return firebasePromise;
+};
+
+export const releasePhoneVerifier = () => {
+  try {
+    verifier?.clear();
+  } catch {
+    // The widget was already removed with the page.
+  }
+  verifierHost?.replaceChildren();
+  verifier = null;
+  verifierHost = null;
+};
+
+// Sends the SMS code. `host` is an element that stays mounted; an invisible reCAPTCHA is rendered inside it.
+export const sendPhoneCode = async (phone, host) => {
+  let firebase;
+  try {
+    firebase = await loadFirebase();
+  } catch (error) {
+    throw friendlyError(error);
+  }
+  const { auth, authModule } = firebase;
+  // A fresh widget per send: an invisible reCAPTCHA token cannot be reused for "Gửi lại mã".
+  releasePhoneVerifier();
+  const mount = document.createElement('div');
+  host.replaceChildren(mount);
+  verifierHost = host;
+  verifier = new authModule.RecaptchaVerifier(auth, mount, { size: 'invisible' });
+  try {
+    return await authModule.signInWithPhoneNumber(auth, toE164(phone), verifier);
+  } catch (error) {
+    releasePhoneVerifier();
+    throw friendlyError(error);
+  }
+};
+
+// Checks the code with Firebase and returns the ID token our backend verifies.
+export const confirmPhoneCode = async (confirmation, code) => {
+  const { auth, authModule } = await loadFirebase();
+  try {
+    const credential = await confirmation.confirm(code);
+    return await credential.user.getIdToken();
+  } catch (error) {
+    throw friendlyError(error);
+  } finally {
+    await authModule.signOut(auth).catch(() => {});
+  }
+};
diff --git a/frontend/src/api/firebasePhoneApi.test.js b/frontend/src/api/firebasePhoneApi.test.js
new file mode 100644
index 0000000..630764e
--- /dev/null
+++ b/frontend/src/api/firebasePhoneApi.test.js
@@ -0,0 +1,85 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+const firebase = vi.hoisted(() => ({
+  auth: { languageCode: null },
+  verifiers: [],
+  initializeApp: vi.fn(() => ({ name: 'phoneshopai' })),
+  initializeAuth: vi.fn(),
+  signInWithPhoneNumber: vi.fn(),
+  signOut: vi.fn(async () => {}),
+}));
+
+vi.mock('firebase/app', () => ({ initializeApp: firebase.initializeApp }));
+vi.mock('firebase/auth', () => ({
+  initializeAuth: firebase.initializeAuth.mockImplementation(() => firebase.auth),
+  inMemoryPersistence: { type: 'NONE' },
+  RecaptchaVerifier: vi.fn(function RecaptchaVerifier(auth, element, options) {
+    this.element = element;
+    this.options = options;
+    this.clear = vi.fn();
+    firebase.verifiers.push(this);
+  }),
+  signInWithPhoneNumber: firebase.signInWithPhoneNumber,
+  signOut: firebase.signOut,
+}));
+vi.mock('../utils/runtimeConfig', () => ({
+  runtimeConfig: { firebase: { apiKey: 'key', authDomain: 'demo.firebaseapp.com', projectId: 'demo', appId: 'app' } },
+}));
+
+const { confirmPhoneCode, firebaseErrorMessage, releasePhoneVerifier, sendPhoneCode, toE164 } = await import('./firebasePhoneApi');
+
+describe('Firebase phone verification helpers', () => {
+  afterEach(() => {
+    releasePhoneVerifier();
+    firebase.verifiers.length = 0;
+    vi.clearAllMocks();
+  });
+
+  it('formats Vietnamese numbers for Firebase', () => {
+    expect(toE164('0912 345 678')).toBe('+84912345678');
+    expect(toE164('+84 912 345 678')).toBe('+84912345678');
+    expect(toE164('12345')).toBe('');
+  });
+
+  it('sends the code with a fresh invisible reCAPTCHA each time, in memory and in Vietnamese', async () => {
+    const host = document.createElement('div');
+    firebase.signInWithPhoneNumber.mockResolvedValue({ confirm: vi.fn() });
+
+    const confirmation = await sendPhoneCode('0912345678', host);
+
+    expect(confirmation).toHaveProperty('confirm');
+    expect(firebase.initializeAuth).toHaveBeenCalledWith({ name: 'phoneshopai' }, { persistence: { type: 'NONE' } });
+    expect(firebase.auth.languageCode).toBe('vi');
+    expect(firebase.signInWithPhoneNumber).toHaveBeenCalledWith(firebase.auth, '+84912345678', firebase.verifiers[0]);
+    expect(firebase.verifiers[0].options).toEqual({ size: 'invisible' });
+    expect(host.children).toHaveLength(1);
+
+    await sendPhoneCode('0912345678', host);
+    expect(firebase.verifiers[0].clear).toHaveBeenCalled();
+    expect(firebase.verifiers).toHaveLength(2);
+    expect(host.children).toHaveLength(1);
+  });
+
+  it('turns Firebase errors into Vietnamese messages and drops the used widget', async () => {
+    const host = document.createElement('div');
+    firebase.signInWithPhoneNumber.mockRejectedValue({ code: 'auth/too-many-requests' });
+
+    await expect(sendPhoneCode('0912345678', host)).rejects.toMatchObject({
+      friendlyMessage: 'Bạn đã yêu cầu quá nhiều lần. Vui lòng thử lại sau ít phút.',
+    });
+    expect(firebase.verifiers[0].clear).toHaveBeenCalled();
+    expect(host.children).toHaveLength(0);
+    expect(firebaseErrorMessage({ code: 'auth/something-new' })).toContain('auth/something-new');
+  });
+
+  it('returns the ID token and signs out of Firebase whatever the outcome', async () => {
+    const confirmation = { confirm: vi.fn().mockResolvedValue({ user: { getIdToken: async () => 'firebase-id-token' } }) };
+    await expect(confirmPhoneCode(confirmation, '246810')).resolves.toBe('firebase-id-token');
+    expect(confirmation.confirm).toHaveBeenCalledWith('246810');
+    expect(firebase.signOut).toHaveBeenCalledTimes(1);
+
+    const wrong = { confirm: vi.fn().mockRejectedValue({ code: 'auth/invalid-verification-code' }) };
+    await expect(confirmPhoneCode(wrong, '000000')).rejects.toMatchObject({ friendlyMessage: 'Mã OTP không đúng. Vui lòng kiểm tra lại.' });
+    expect(firebase.signOut).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/frontend/src/pages/RegisterFirebase.test.jsx b/frontend/src/pages/RegisterFirebase.test.jsx
