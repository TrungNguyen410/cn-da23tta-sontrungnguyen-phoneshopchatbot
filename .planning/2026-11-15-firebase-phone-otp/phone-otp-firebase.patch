+const crypto = require('crypto');
+const jwt = require('jsonwebtoken');
+const request = require('supertest');
+const env = require('../src/config/env');
+const User = require('../src/models/User');
+const firebaseTokenVerifier = require('../src/services/firebaseTokenVerifier');
+const { app, createUser } = require('./helpers');
+
+const PROJECT_ID = 'phoneshopai-test';
+const keyPair = () => crypto.generateKeyPairSync('rsa', {
+  modulusLength: 2048,
+  publicKeyEncoding: { type: 'spki', format: 'pem' },
+  privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+});
+const googleKey = keyPair();
+const strangerKey = keyPair();
+const nowSeconds = () => Math.floor(Date.now() / 1000);
+
+const firebaseToken = ({
+  phone = '+84912345678',
+  provider = 'phone',
+  authTime = nowSeconds(),
+  audience = PROJECT_ID,
+  privateKey = googleKey.privateKey,
+  keyid = 'google-key-1',
+} = {}) => jwt.sign(
+  { phone_number: phone, auth_time: authTime, firebase: { sign_in_provider: provider, identities: { phone: [phone] } } },
+  privateKey,
+  { algorithm: 'RS256', keyid, audience, issuer: `https://securetoken.google.com/${audience}`, subject: 'firebase-uid-1', expiresIn: '1h' },
+);
+
+const details = { fullName: 'Phạm Quốc Huy', phone: '0912345678', password: 'mat-khau-1' };
+const register = (body) => request(app).post('/api/auth/register/firebase').send(body);
+
+describe('Registration with Firebase Phone Auth', () => {
+  let originalProjectId;
+  let originalFetch;
+
+  beforeEach(() => {
+    originalProjectId = env.firebase.projectId;
+    originalFetch = firebaseTokenVerifier.fetchImpl;
+    env.firebase.projectId = PROJECT_ID;
+    firebaseTokenVerifier.clearCache();
+    firebaseTokenVerifier.fetchImpl = jest.fn(async () => ({
+      ok: true,
+      headers: { get: () => 'public, max-age=3600' },
+      json: async () => ({ 'google-key-1': googleKey.publicKey }),
+    }));
+  });
+
+  afterEach(() => {
+    env.firebase.projectId = originalProjectId;
+    firebaseTokenVerifier.fetchImpl = originalFetch;
+    firebaseTokenVerifier.clearCache();
+  });
+
+  it('checks the number before any SMS is sent', async () => {
+    await createUser({ email: 'taken@test.com', phone: '0988888888' });
+
+    const free = await request(app).post('/api/auth/register/check-phone').send({ phone: '+84 912 345 678' });
+    expect(free.status).toBe(200);
+    expect(free.body.data).toEqual({ available: true });
+
+    const taken = await request(app).post('/api/auth/register/check-phone').send({ phone: '0988888888' });
+    expect(taken.status).toBe(409);
+
+    const invalid = await request(app).post('/api/auth/register/check-phone').send({ phone: '12345' });
+    expect(invalid.status).toBe(422);
+  });
+
+  it('creates a verified customer from a valid phone token and lets them log in', async () => {
+    const response = await register({ ...details, idToken: firebaseToken() });
+
+    expect(response.status).toBe(201);
+    expect(response.body.data.token).toBeTruthy();
+    expect(response.body.data.user).toMatchObject({ phone: '0912345678', role: 'customer', phoneVerified: true });
+    expect(response.body.data.user.password).toBeUndefined();
+
+    const stored = await User.findOne({ phone: '0912345678' }).select('+password');
+    expect(stored.password).not.toBe(details.password);
+
+    const loggedIn = await request(app).post('/api/auth/login').send({ identifier: '0912345678', password: details.password });
+    expect(loggedIn.status).toBe(200);
+  });
+
+  it('rejects a token for another phone, project, key or sign-in method', async () => {
+    const cases = [
+      [{ phone: '+84987654321' }, 400],
+      [{ audience: 'another-project' }, 401],
+      [{ privateKey: strangerKey.privateKey }, 401],
+      [{ provider: 'password' }, 401],
+      [{ authTime: nowSeconds() - 20 * 60 }, 401],
+    ];
+    for (const [tokenOptions, status] of cases) {
+      const response = await register({ ...details, idToken: firebaseToken(tokenOptions) });
+      expect({ tokenOptions, status: response.status }).toEqual({ tokenOptions, status });
+    }
+    expect(await User.countDocuments({ phone: '0912345678' })).toBe(0);
+  });
+
+  it('refuses a number that is already registered', async () => {
+    await createUser({ email: 'existing@test.com', phone: '0912345678' });
+    const response = await register({ ...details, idToken: firebaseToken() });
+    expect(response.status).toBe(409);
+  });
+
+  it('does not accept self-assigned roles or a missing token', async () => {
+    const withRole = await register({ ...details, idToken: firebaseToken(), role: 'admin' });
+    expect(withRole.status).toBe(422);
+
+    const withoutToken = await register(details);
+    expect(withoutToken.status).toBe(422);
+  });
+
+  it('refetches Google keys once when the key id is new', async () => {
+    firebaseTokenVerifier.fetchImpl
+      .mockResolvedValueOnce({ ok: true, headers: { get: () => 'max-age=3600' }, json: async () => ({ 'old-key': strangerKey.publicKey }) });
+
+    const response = await register({ ...details, idToken: firebaseToken() });
+    expect(response.status).toBe(201);
+    expect(firebaseTokenVerifier.fetchImpl).toHaveBeenCalledTimes(2);
+  });
+
+  it('answers 503 when Firebase is not configured on the server', async () => {
+    env.firebase.projectId = '';
+    const response = await register({ ...details, idToken: firebaseToken() });
+    expect(response.status).toBe(503);
+  });
+});
