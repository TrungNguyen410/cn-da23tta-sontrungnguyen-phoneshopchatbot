VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK=true
VITE_SITE_URL=http://localhost:5173
VITE_DEPLOYMENT_TARGET=local-preview
# Allowed targets: local (dev server only), local-preview, docker, render.
# local-preview is the explicit localhost exception for `npm run build && npm run preview`.
# Render production rejects localhost VITE_API_URL and VITE_SITE_URL values.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Hai biến Cloudinary là tùy chọn nhưng phải được điền cùng nhau để tải ảnh từ máy.
# Upload preset phải là unsigned. Nếu để trống, trang quản trị chỉ nhận URL ảnh HTTPS.
VITE_GA_MEASUREMENT_ID=
# Firebase Authentication cho nút đăng nhập Google/Facebook (tùy chọn). Chỉ dùng khi VITE_USE_MOCK=false và đủ 3 biến đầu;
# để trống thì ẩn hai nút này (vẫn đăng ký/đăng nhập bằng số điện thoại + mật khẩu).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
