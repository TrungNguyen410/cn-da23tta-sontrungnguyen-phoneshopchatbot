NODE_ENV=development
PORT=5000
# Must target a MongoDB replica set or sharded cluster (transactions are required).
MONGO_URI=mongodb://127.0.0.1:27017/techphone_store?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
UPLOAD_DIR=uploads
DEPLOYMENT_TARGET=local
# Allowed targets: local, docker, render, vercel, netlify, serverless, aws-lambda.
# Production supports render or docker; recognized serverless targets fail because uploads are local.
# VERCEL, NETLIFY, or AWS_LAMBDA_FUNCTION_NAME always identifies the actual
# serverless platform and cannot be hidden by DEPLOYMENT_TARGET.
SEED_DEMO_PASSWORD=123456

# Twilio SMS OTP (required when NODE_ENV=production; leave empty for development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Public bank transfer and MoMo display details
BANK_NAME=
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
MOMO_PHONE=
MOMO_ACCOUNT_NAME=

# VNPay sandbox/production merchant credentials. VNPAY_RETURN_URL is required
# only when both VNPAY_TMN_CODE and VNPAY_HASH_SECRET are configured.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_VERSION=2.1.0
