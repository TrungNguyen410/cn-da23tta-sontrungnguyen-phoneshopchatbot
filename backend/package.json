{
  "name": "techphone-store-backend",
  "version": "1.0.0",
  "description": "Clean Architecture REST API for the TechPhone Store course project.",
  "main": "server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node src/seed/seed.js",
    "migrate:taxonomy": "node src/scripts/migrateCatalogTaxonomy.js",
    "migrate:phone-auth": "node src/scripts/migratePhoneAuth.js",
    "migrate:soft-delete-indexes": "node src/scripts/migrateSoftDeleteIndexes.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "clean-architecture",
    "techphone"
  ],
  "author": "TechPhone Store",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/swagger.js",
      "!src/seed/**",
      "!src/scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 70,
        "lines": 85,
        "statements": 80
      }
    }
  }
}
