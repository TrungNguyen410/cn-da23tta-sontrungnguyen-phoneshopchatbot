JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SEED_DEMO_PASSWORD=replace-with-a-demo-password-at-least-12-characters

# AI chatbot (Gemini). Empty = offline rule-based mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Bank transfer QR + SePay automatic confirmation (optional)
BANK_NAME=
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

# Optional fixed public URL for the SePay webhook (ngrok free static domain)
# COMPOSE_PROFILES=tunnel
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Firebase Authentication for Google/Facebook sign-in (optional; empty = the buttons are hidden).
# Values come from Firebase console > Project settings > Your apps > firebaseConfig (public web config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Backend checks Firebase ID tokens against this project (same value as VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=
